// tui.psp —— 终端界面（TUI）示例：全屏 ANSI 界面 + 键盘交互
//
// 语言内建 TUI 能力（纯 std，直接写 ANSI 转义序列，无需宿主 Rust）：
//   clear_screen()          清屏并复位光标
//   cursor(x, y)            移动光标到 (x, y)（1 基）
//   color(fg, bg)           设置前景/背景色（0-255，ANSI 256 色；或名字）
//   reset_color()           恢复默认颜色
//   hide_cursor() / show_cursor()
//   key()                   阻塞读取一个按键 -> str（方向键/功能键给名字）
//   key_available()         -> bool 是否有按键等待
//   terminal_cols()         终端列数 -> int
//   terminal_rows()         终端行数 -> int
//   sleep(ms)               休眠（已内建）
//
// 运行：   pss run examples/tui.psp --no-daemon
// 打包：   pssc examples/tui.psp -o tui.project && pss tui.project
//
// 界面：一个居中的简单状态屏，↑/↓ 改计数，q 退出。

func main() -> int {
  hide_cursor()
  var rows = terminal_rows()
  var cols = terminal_cols()
  var count = 0

  while true {
    clear_screen()
    var cx = cols / 2
    var cy = rows / 2 - 2

    color(220, 0)          // 亮色前景
    cursor(cx - 12, cy)
    write("=== PointerSes TUI ===")
    reset_color()

    color(15, 0)
    cursor(cx - 12, cy + 1)
    printf("行数: %d  列数: %d", rows, cols)
    cursor(cx - 12, cy + 2)
    printf("计数: %d", count)
    reset_color()

    color(45, 0)
    cursor(cx - 20, cy + 4)
    write("按 ↑ / ↓ 调整计数, 按 q 退出")
    reset_color()

    var k = key()
    if k == "q" {
      break
    } else if k == "up" {
      count = count + 1
    } else if k == "down" {
      count = count - 1
    }
  }

  clear_screen()
  show_cursor()
  say("退出时计数 = " + count)
  return 0
}
